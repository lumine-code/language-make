{
  "name": "MAKE",
  "scopeName": "source.makefile",
  "type": "modern-tree-sitter",
  "parser": "tree-sitter-make",
  "injectionRegex": "^(make|makefile)$",
  // Matches the TextMate grammar's shebang rule, which would otherwise win by
  // 0.5 against the 0.1 that prefers Tree-sitter.
  "firstLineRegex": ["^#!\\s*/.*\\bmake\\s+-f", "vim\\b.*\\bset\\b.*\\b(filetype|ft|syntax)=make"],
  "fileTypes": [
    "Makefile",
    "makefile",
    "BSDmakefile",
    "GNUmakefile",
    "OCamlMakefile",
    "Kbuild",
    "am",
    "mak",
    "make",
    "mf",
    "mk",
    "mkfile"
  ],
  "comments": {
    "start": "# "
  },
  "treeSitter": {
    "parserSource": "github:alemuller/tree-sitter-make#a4b9187417d6be349ee5fd4b6e77b4172c6827dd",
    "wasmBuildTool": "tree-sitter-cli#v0.26.11",
    "grammar": "tree-sitter-make/tree-sitter-make.wasm",
    "highlightsQuery": "tree-sitter-make/highlights.scm"
  }
}
