{
  "name": "MAKE",
  "scopeName": "source.makefile",
  "type": "tree-sitter",
  "parser": "tree-sitter-make",
  "injectionNames": ["make", "makefile", "bsdmake", "mf"],
  // Recognizes executable makefiles and editor modelines.
  // Stop at the first Vim and set tokens instead of backtracking over them.
  // \x0a keeps existing shebang prefix line counts unchanged.
  "firstLineRegex": [
    "^#![ \\t]*(?:/[^\\x0d\\x0a \\t]*/make|/[^\\x0d\\x0a \\t]*/env(?:\\.exe)?[ \\t]+(?:-S[ \\t]+)?make)[ \\t]+-f(?=[ \\t\\x0d\\x0a]|$)",
    "(?:^|\\x0a)(?:(?!vim\\b).)*vim\\b(?:(?!\\bset\\b).)*\\bset\\b.*\\b(filetype|ft|syntax)=make(?=[ \\t:\\x0d\\x0a]|$)"
  ],
  "fileTypes": [
    "Makefile",
    "makefile",
    "BSDmakefile",
    "GNUmakefile",
    "OCamlMakefile",
    "Kbuild",
    "am",
    "mak",
    "make",
    "mf",
    "mk",
    "mkfile",
    "Makefile.in",
    "imk",
    "Makefile.cmake",
    "Makefile2"
  ],
  "comments": {
    "start": "# "
  },
  "treeSitter": {
    "parserSource": "github:alemuller/tree-sitter-make#a4b9187417d6be349ee5fd4b6e77b4172c6827dd",
    "wasmBuildTool": "tree-sitter-cli#v0.27.1",
    "grammar": "make.wasm",
    "tagsQuery": "make-tags.scm",
    "highlightsQuery": "make-highlights.scm"
  }
}
