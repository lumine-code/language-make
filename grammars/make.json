{
  "name": "MAKE",
  "scopeName": "source.makefile",
  "type": "tree-sitter",
  "parser": "tree-sitter-make",
  "injectionNames": ["make", "makefile"],
  // Recognizes executable makefiles and editor modelines.
  "firstLineRegex": ["^#!\\s*/.*\\bmake\\s+-f", "vim\\b.*\\bset\\b.*\\b(filetype|ft|syntax)=make"],
  "fileTypes": [
    "Makefile",
    "makefile",
    "BSDmakefile",
    "GNUmakefile",
    "OCamlMakefile",
    "Kbuild",
    "am",
    "mak",
    "make",
    "mf",
    "mk",
    "mkfile",
    "Makefile.in",
    "imk",
    "Makefile.cmake",
    "Makefile2"
  ],
  "comments": {
    "start": "# "
  },
  "treeSitter": {
    "parserSource": "github:alemuller/tree-sitter-make#a4b9187417d6be349ee5fd4b6e77b4172c6827dd",
    "wasmBuildTool": "tree-sitter-cli#v0.27.0",
    "grammar": "make.wasm",
    "highlightsQuery": "make-highlights.scm"
  }
}
